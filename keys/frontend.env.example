# FRONTEND (Next.js)
# Local:      copy to frontend/.env.local   (or run keys/setup.sh)
# Production: Vercel > Project > Settings > Environment Variables
# Never prefix any of these with NEXT_PUBLIC_ (that would expose them to browsers).

NEXTAUTH_URL=http://localhost:3000          # production: https://<your-vercel-domain>
NEXTAUTH_SECRET=                            # openssl rand -base64 32   (use a different one per environment)

GOOGLE_CLIENT_ID=                           # Google Cloud Console > Google Auth Platform > Clients
GOOGLE_CLIENT_SECRET=

BACKEND_URL=http://127.0.0.1:8000           # production: https://<your-railway-domain>
ENGINE_API_KEY=                             # MUST be identical to ENGINE_API_KEY in the backend

# AI advisor: set ONE key. Gemini has a free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=                               # optional, default gemini-3.6-flash (falls back automatically)
ANTHROPIC_API_KEY=                          # optional paid alternative
ANTHROPIC_MODEL=
ADVISOR_PROVIDER=auto                       # auto | gemini | claude | mock

# Billing: leave empty to use the built-in simulated checkout
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
