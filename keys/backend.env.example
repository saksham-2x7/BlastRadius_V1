# BACKEND (FastAPI + MCP)
# Local:      copy to backend/.env          (or run keys/setup.sh)
# Production: Railway > service "blastradius" > Variables

ENGINE_API_KEY=                             # openssl rand -hex 24. MUST be identical to ENGINE_API_KEY in the frontend
CORS_ORIGINS=http://localhost:3000          # production: https://<your-vercel-domain> (exact origins, never *)
MCP_ALLOWED_HOSTS=                          # production: <your-railway-domain> (no https://)

# How the backend reaches the database (the database layer reads these)
FALKORDB_HOST=127.0.0.1                     # Railway: ${{falkordb.RAILWAY_PRIVATE_DOMAIN}}
FALKORDB_PORT=6379
FALKORDB_PASSWORD=                          # same value as the database server's password (see database.env.example)
FALKORDB_USERNAME=                          # only for managed services such as FalkorDB Cloud
FALKORDB_SSL=                               # true for managed services that require TLS
FALKORDB_GRAPH=blastradius
FALKORDB_ACCOUNTS_GRAPH=blastradius_accounts
GITHUB_TOKEN=                               # optional: fine-grained token with Issues: write on ONE repo. Enables the agent's file_github_issue tool
GITHUB_REPO=                                # optional: owner/repo that receives the issues
DEMO_RESET_MINUTES=10                       # public demo: after this many quiet minutes the solved graph snaps back to the sample (0 = off)
