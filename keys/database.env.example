# DATABASE (FalkorDB server)
# These configure the FalkorDB SERVER container, not the apps that connect to it.
# Local:      database/docker-compose.yml reads them from the shell or database/.env
# Production: Railway > service "falkordb" > Variables

BROWSER=0                                   # 0 = do not start FalkorDB's web UI (always 0 in production)
REDIS_ARGS=--requirepass CHANGE_ME --appendonly yes
# ^ CHANGE_ME = the database password: openssl rand -hex 24
#   The same password goes in the backend as FALKORDB_PASSWORD.
